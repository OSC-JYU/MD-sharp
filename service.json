{
    "local_url": "http://localhost:9000",
    "id": "md-sharp",
    "type": "image",
    "category": "preparation",
    "api_type": "elg",
    "adapter": "elg",
    "api": "/process",
    "name": "Sharp",
    "description": "Image processing service based on sharp/libvips. Supports resize, fit, flip, rotate, blur, convert and automatic dual-output (preview + thumbnail) generation. Works either as a plain HTTP API (adapter: elg) or, when MD_PATH is set, in disk storage mode reading/writing directly on the shared MessyDesk data volume (adapter: elg_fs) so the consumer never handles file bytes. Replaces the in-process sharp-thumbnailer adapter and can also replace Imaginary for basic image transforms.",
    "source_url": "https://sharp.pixelplumbing.com/",

    "supported_types": ["image"],
    "supported_formats": ["png", "jpg", "jpeg", "webp", "tiff", "tif", "svg"],

    "params_help": {
        "width": {
            "name": "width",
            "default": 200,
            "help": "Width of the image in pixels",
            "display": "textinput"
        },
        "height": {
            "name": "height",
            "default": 200,
            "help": "Height of the image in pixels",
            "display": "textinput"
        }
    },

    "tasks": {
        "thumbnail": {
            "name": "Thumbnail",
            "output": "image",
            "description": "Generate an 800px preview and a 200px thumbnail from an image. Called automatically after image uploads/edits; not user-selectable.",
            "params": {
                "width": 800,
                "type": "jpeg"
            },
            "params_help": {},
            "info": "I generated a preview and thumbnail for this image."
        },

        "resize": {
            "name": "Resize by width",
            "output": "image",
            "description": "Resize image, keeping aspect ratio.",
            "params": {"width": 400},
            "params_help": {
                "width": {
                    "name": "Image width in pixels",
                    "help": "How much image is resized."
                }
            },
            "info": "I resized image to {{width}}px wide."
        },

        "fit": {
            "name": "Resize",
            "output": "image",
            "description": "Resize image to fit inside a bounding box, keeping aspect ratio.",
            "params": {"width": 200, "height": 200},
            "params_help": {},
            "info": "I resized image to fit inside {{width}}x{{height}}."
        },

        "flip": {
            "name": "Flip",
            "output": "image",
            "description": "Flip image vertically.",
            "params": {},
            "params_help": {},
            "info": "I flipped image."
        },

        "rotate": {
            "name": "Rotate",
            "output": "image",
            "description": "Rotate image by given angle.",
            "params": {
                "rotate": 90
            },
            "params_help": {
                "rotate": {
                    "name": "rotate angle (90, 180, 270)",
                    "help": "How much image is rotated.",
                    "default": 90,
                    "values": [{"title": "90", "value": 90}, {"title": "180", "value": 180}, {"title": "-90", "value": 270}],
                    "display": "dropdown"
                }
            },
            "info": "I rotated image {{rotate}} degrees."
        },

        "blur": {
            "name": "Blur",
            "output": "image",
            "description": "Blur image.",
            "params": {
                "sigma": 2
            },
            "params_help": {
                "sigma": {
                    "name": "sigma",
                    "help": "How much image is blurred. Note that sigma is an absolute value, not a percentage. This means that the same sigma value blurs a small image more than a large image.",
                    "default": 2
                }
            },
            "info": "I blurred image by {{sigma}}."
        },

        "convert": {
            "name": "Convert",
            "output": "image",
            "description": "Convert image to another format.",
            "params": {
                "type": "jpeg",
                "quality": 80
            },
            "params_help": {
                "type": {
                    "name": "format",
                    "help": "Format to convert to",
                    "default": "jpeg",
                    "values": [{"title": "jpg", "value": "jpeg"}, {"title": "png", "value": "png"}, {"title": "webp", "value": "webp"}],
                    "display": "dropdown"
                },
                "quality": {
                    "name": "quality",
                    "help": "Quality of the image (only for jpg and webp, 0-100)",
                    "default": 80,
                    "display": "textinput"
                }
            },
            "info": "I converted image to {{type}}. JPEG quality is {{quality}}."
        }
    }
}
